{
    "services": {
      "frontend": {
        "root": "frontend",
        "framework": "vite"
      },
      "backend": {
        "root": "backend",
        "framework": "express",
        "entrypoint": "src/server.ts"
      }
    },
    "rewrites": [
      { "source": "/healthz", "destination": { "service": "backend" } },
      { "source": "/openapi.json", "destination": { "service": "backend" } },
      { "source": "/v1/(.*)", "destination": { "service": "backend" } },
      { "source": "/(.*)", "destination": { "service": "frontend" } }
    ]
  }